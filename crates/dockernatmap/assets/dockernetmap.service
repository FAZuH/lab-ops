[Unit]
Description=dockernatmap — Dynamic Docker port remapping daemon
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
ExecStart={binary} dockernatmap daemon --state-dir {state_dir} --socket /run/dockernatmap.sock --socket-group {group}
ExecReload={binary} dockernatmap reload
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
